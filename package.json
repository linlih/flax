{
  "name": "paper",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @paper/desktop",
    "build": "npm run build -w @paper/desktop",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/core/tsconfig.test.json && npm run typecheck -w @paper/desktop"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
