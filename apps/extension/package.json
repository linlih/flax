{
  "name": "@flax/extension",
  "version": "0.1.20",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "把正在看的论文存进 Flax 文献库的浏览器插件",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "wxt": "0.21.5"
  }
}
