{
  "expo": {
    "name": "Flax",
    "slug": "flax",
    "scheme": "flax",
    "version": "0.1.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "app.flax.mobile",
      "versionCode": 1004
    },
    "ios": {
      "bundleIdentifier": "app.flax.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": false
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "text/plain"
            ],
            "multipleShareMimeTypes": [
              "application/pdf"
            ]
          }
        }
      ],
      "./plugins/withReaderAssets",
      "./plugins/withReleaseSigning"
    ]
  }
}
