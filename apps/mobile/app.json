{
  "expo": {
    "name": "Flax",
    "slug": "flax",
    "scheme": "flax",
    "version": "0.1.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "app.flax.mobile",
      "versionCode": 1005,
      "icon": "./assets/icon-ios.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-fg.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png"
      }
    },
    "ios": {
      "bundleIdentifier": "app.flax.mobile",
      "supportsTablet": true,
      "buildNumber": "1005",
      "icon": "./assets/icon-ios.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": false
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "text/plain"
            ],
            "multipleShareMimeTypes": [
              "application/pdf"
            ]
          }
        }
      ],
      "./plugins/withReaderAssets",
      "./plugins/withReleaseSigning",
      "expo-status-bar"
    ]
  }
}
