{
  "name": "@flax/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "npm run build:reader && expo prebuild --platform android",
    "typecheck": "tsc --noEmit && tsc -p reader-web",
    "build:reader": "vite build --config reader-web/vite.config.mts",
    "prebuild:ios": "npm run build:reader && expo prebuild --platform ios"
  },
  "dependencies": {
    "@flax/core": "*",
    "expo": "58.0.24",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.19",
    "expo-file-system": "58.0.13",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-sqlite": "58.0.16",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.8",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  }
}
